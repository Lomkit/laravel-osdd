{
    "name": "lomkit/laravel-osdd",
    "description": "Package to handle OSDD in a Laravel application.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gautier DELEGLISE",
            "email": "gautier@lomkit.com"
        }
    ],
    "require": {
        "laravel/framework": "^12 || ^13",
        "php": "^8.3",
        "ext-dom": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Lomkit\\Osdd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lomkit\\Osdd\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lomkit\\Osdd\\OsddServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    }
}