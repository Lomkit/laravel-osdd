{
    "name": "lomkit/laravel-osdd",
    "description": "Split a Laravel application into domain modules: one Composer package per domain, with the boundaries between them checked in CI.",
    "keywords": ["laravel", "osdd", "modules", "modular", "modular-monolith", "domain-driven-design", "layers", "architecture", "composer", "lomkit"],
    "type": "library",
    "homepage": "https://laravel-osdd.lomkit.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Gautier Deleglise",
            "email": "gautier@lomkit.com"
        }
    ],
    "support": {
        "docs": "https://laravel-osdd.lomkit.com"
    },
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^12.5 || ^13.0",
        "tomasvotruba/type-coverage": "^2.5"
    },
    "conflict": {
        "xefi/laravel-osdd": "*"
    },
    "autoload": {
        "psr-4": {
            "Lomkit\\Osdd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lomkit\\Osdd\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lomkit\\Osdd\\OsddServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
