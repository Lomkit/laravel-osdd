{
    "name": "lomkit/laravel-osdd",
    "description": "A package to split a Laravel application into independent layers.",
    "keywords": ["laravel", "osdd", "layers", "modules", "lomkit"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gautier Deleglise",
            "email": "gautier@lomkit.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "conflict": {
        "xefi/laravel-osdd": "*"
    },
    "autoload": {
        "psr-4": {
            "Lomkit\\Osdd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lomkit\\Osdd\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lomkit\\Osdd\\OsddServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
